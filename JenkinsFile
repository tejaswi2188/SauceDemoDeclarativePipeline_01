pipeline
{
   agent any
   parameters
    {

       choice( name :'ENVIRONMENT_NAME',
        choices :['qa','uat','staging'],
        description :'Select the environment Name'
        )
         choice ( 
           name :'BROWSER_NAME',
          choices :['chromium','webkit'],
          description :'Select the browser Name'
          )

          choice (
           name :'SUITE_NAME',
           choices :['Regression','Smoke','sanity','e2e'],
           description : 'Select the Suite Name'
               )

       String (
             name : 'BRANCH_NAME',
             defaultValue : 'master',
             description :'Enter Branch Name'

              )

     String (

               name : 'WORKER_NUMBER',
               defaultValue :1,
                description :'Enter worker Number'
             )

         }
 stages
{
    stage("Clone GitHub Repository")
     {
         steps
         {
              git url : 'https://github.com/tejaswi2188/SauceDemoDeclarativePipeline_01.git',branch: "${BRANCH_NAME}"
          }
     }

    stage("Install package.json dependencies")
     {
         steps
          {
               bat npm ci
           }
       }

      stage("install playwright")
       {
           steps
            {
                bat "npm install playwright"
             }
         }

     stage("Execute Test cases")
      {

          steps
          {

                bat "if exist  allure- results rmdir/s/q allure-results"
                bat set TEST_ENV = %ENVIRONMENT_NAME%
                bat npx playwright test --project=%BROWSER_NAME% --grep %SUITE_NAME% --workers=%WORKER_NUMBER%

          }
      }

}

post {

always
{

   script 
       {

           allure ([

                includeProperties : false,
                 reportBuildPolicy : 'ALWAYS',
                 result : [[path : 'allure-results']]
              ])

}

}

}

}






